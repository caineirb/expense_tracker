      </Text>
      <Button fx:id="dashboardButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#switchToDashboard" prefHeight="50.0" prefWidth="326.0" style="-fx-background-color: #00000000;" text="Dashboard" textAlignment="CENTER">
         <font>
            <Font name="Roboto Mono Regular" size="17.0" />
         </font>
      </Button>
      <Button fx:id="transactionsButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#switchToTransactions" prefHeight="50.0" prefWidth="326.0" style="-fx-background-color: #00000000;" text="Transactions" textAlignment="CENTER">
         <font>
            <Font name="Roboto Mono Regular" size="17.0" />
