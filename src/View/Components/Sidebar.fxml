      </Button>
      <Button fx:id="analyticsButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#switchToAnalytics" prefHeight="50.0" prefWidth="326.0" style="-fx-background-color: #00000000;" text="Analytics" textAlignment="CENTER">
