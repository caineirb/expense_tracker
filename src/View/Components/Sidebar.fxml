      <Pane prefHeight="436.0" prefWidth="326.0" />
      <Separator prefHeight="0.0" prefWidth="326.0" />
      <Text fill="#00000069" strokeType="OUTSIDE" strokeWidth="0.0" text="Caine Ivan Bautista">
         <font>
            <Font name="Roboto Mono Italic" size="9.0" />
