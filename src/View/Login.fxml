<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="loginScreen" maxHeight="220.0" maxWidth="540.0" minHeight="220.0" minWidth="540.0" prefHeight="220.0" prefWidth="540.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.Login">
   <children>
      <Label alignment="CENTER" layoutX="108.0" layoutY="14.0" prefHeight="43.0" prefWidth="326.0" text="Expense Tracker Login">
         <font>
            <Font name="Roboto Mono Regular" size="24.0" />
         </font></Label>
      <TextField fx:id="username" layoutX="131.0" layoutY="71.0" prefHeight="27.0" prefWidth="361.0" promptText="your username" />
      <Text layoutX="50.0" layoutY="90.0" onMouseClicked="#handleUsernameFocus" strokeType="OUTSIDE" strokeWidth="0.0" text="Username">
         <font>
            <Font name="Roboto Mono Regular" size="13.0" />
         </font>
      </Text>
      <Text layoutX="50.0" layoutY="123.0" onMouseClicked="#handlePasswordFocus" strokeType="OUTSIDE" strokeWidth="0.0" text="Password">
         <font>
            <Font name="Roboto Mono Regular" size="13.0" />
         </font>
      </Text>
      <PasswordField fx:id="password" layoutX="131.0" layoutY="104.0" prefHeight="26.0" prefWidth="361.0" promptText="****************" />
      <Button fx:id="loginButton" layoutX="242.0" layoutY="145.0" defaultButton="true" mnemonicParsing="false" onAction="#handleLogin" onMouseClicked="#handleLogin" text="Login">
         <font>
            <Font name="Roboto Mono Regular" size="13.0" />
         </font>
      </Button>
      <Text layoutX="128.0" layoutY="199.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Don't have an account yet? " />
      <Hyperlink fx:id="registerLink" layoutX="295.0" layoutY="182.0" onMouseClicked="#handleRegister" text="Create an account" />
   </children>
</AnchorPane>
