<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="loginScreen" maxHeight="150.0" maxWidth="400.0" minHeight="150.0" minWidth="400.0" prefHeight="150.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.Auth.Login">
   <top>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Enter Password" BorderPane.alignment="CENTER">
         <font>
            <Font name="Roboto Mono Regular" size="25.0" />
         </font>
      </Text>
   </top>
   <center>
      <PasswordField fx:id="dbPassword" promptText="Database Password" BorderPane.alignment="CENTER" />
   </center>
   <bottom>
      <Button fx:id="submitPassword" defaultButton="true" mnemonicParsing="false" onAction="#handleDatabaseEnter" text="Enter" BorderPane.alignment="CENTER">
         <font>
            <Font name="Roboto Mono Regular" size="14.0" />
         </font></Button>
   </bottom>
   <padding>
      <Insets bottom="20.0" left="35.0" right="35.0" top="10.0" />
   </padding>
</BorderPane>
