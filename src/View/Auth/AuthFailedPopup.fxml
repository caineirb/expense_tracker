<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="authFailedPopup" cache="true" maxHeight="100.0" maxWidth="250.0" minHeight="100.0" minWidth="250.0" prefHeight="100.0" prefWidth="250.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.Auth.AuthFailedPopup">
   <center>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Incorrect Database Password" BorderPane.alignment="CENTER">
         <font>
            <Font name="Roboto Mono Regular" size="14.0" />
         </font>
      </Text>
   </center>
   <bottom>
      <Button fx:id="okayButton" defaultButton="true" mnemonicParsing="false" onAction="#handleOkayButton" text="Okay" BorderPane.alignment="CENTER">
         <font>
            <Font name="Roboto Mono Regular" size="13.0" />
         </font>
      </Button>
   </bottom>
   <padding>
      <Insets bottom="20.0" />
   </padding>
</BorderPane>
