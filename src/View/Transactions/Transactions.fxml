<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane fx:id="transactionsScreen" maxHeight="768.0" maxWidth="1366.0" minHeight="768.0" minWidth="1366.0" prefHeight="768.0" prefWidth="1366.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.Transactions.Transactions">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <center>
      <TableView fx:id="transactionsTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="numberColumn" editable="false" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" resizable="false" sortType="DESCENDING" text="No." />
            <TableColumn fx:id="nameColumn" editable="false" prefWidth="266.0" sortable="false" text="Name" />
            <TableColumn fx:id="descriptionColumn" editable="false" prefWidth="364.0" sortable="false" text="Description" />
            <TableColumn fx:id="dateColumn" editable="false" prefWidth="211.0" sortType="DESCENDING" text="Date" />
            <TableColumn fx:id="locationColumn" editable="false" prefWidth="317.0" sortable="false" text="Location" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
</BorderPane>
